# Trello Test Configuration — copy this file to .env and fill in your values
# OR export the variables directly in your shell / CI environment.

# Trello URL
TRELLO_URL=https://trello.com/login

# Primary account credentials
TRELLO_EMAIL=your_email@example.com
TRELLO_PASSWORD=your_password

# Second Trello account — required only for Collaboration tests
# Both accounts must already be members of the same Workspace.
TRELLO_EMAIL_SECOND=your_second_email@example.com
TRELLO_PASSWORD_SECOND=your_second_password

# Browser: firefox (default) | chrome | edge
BROWSER=firefox

# Headless mode: true | false (default false)
HEADLESS=false
